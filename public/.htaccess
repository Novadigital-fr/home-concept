# Hébergement OVH mutualisé (Apache). Déployé avec le site par la GitHub Action.

RewriteEngine On

# Une seule adresse officielle : https://homeconcept-renovation.fr (sans www).
# Les variantes http:// et www. sont redirigées en 301 pour éviter le contenu dupliqué.
# (OVH termine le HTTPS en amont : on teste le port plutôt que %{HTTPS}.)
RewriteCond %{SERVER_PORT} 80 [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://homeconcept-renovation.fr/$1 [R=301,L]

# /contact (URL que les gens tapent souvent) -> page de devis.
RewriteRule ^contact/?$ https://homeconcept-renovation.fr/votre-projet/ [R=301,L]

# Dossier demandé sans slash final (/menuiserie) -> /menuiserie/ en une seule redirection propre.
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*[^/])$ https://homeconcept-renovation.fr/$1/ [R=301,L]

ErrorDocument 404 /404.html

# Cache navigateur long pour les fichiers versionnés et les images (bon pour les Core Web Vitals).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
